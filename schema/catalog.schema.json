{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dataelement/awesome-dsh-workbench/schema/catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "categories",
    "workbenches"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "catalog"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "https://github.com/dataelement/awesome-dsh-workbench/schema/workbench.schema.json#/properties/category"
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh"
            ],
            "properties": {
              "zh": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "workbenches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "workbenchId",
          "owner",
          "repository",
          "url",
          "name",
          "category",
          "description",
          "version",
          "sourceCommit",
          "license",
          "distribution",
          "screenshots",
          "probe"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "workbenchId": {
            "$ref": "https://github.com/dataelement/awesome-dsh-workbench/schema/workbench.schema.json#/properties/workbenchId"
          },
          "legacyWorkbenchIds": {
            "$ref": "https://github.com/dataelement/awesome-dsh-workbench/schema/workbench.schema.json#/properties/legacyWorkbenchIds"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "$ref": "https://github.com/dataelement/awesome-dsh-workbench/schema/workbench.schema.json#/properties/url"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "$ref": "https://github.com/dataelement/awesome-dsh-workbench/schema/workbench.schema.json#/properties/category"
          },
          "description": {
            "$ref": "https://github.com/dataelement/awesome-dsh-workbench/schema/workbench.schema.json#/properties/description"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sourceCommit": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{40}$"
          },
          "updatedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "distribution": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "name",
                  "url",
                  "integrity",
                  "sha256",
                  "bytes",
                  "version"
                ],
                "properties": {
                  "type": {
                    "const": "npm"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^https://registry\\.npmjs\\.org/"
                  },
                  "integrity": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
                  },
                  "sha256": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8388608
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "url",
                  "sha256",
                  "bytes",
                  "version"
                ],
                "properties": {
                  "type": {
                    "const": "github-release"
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/download/"
                  },
                  "sha256": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8388608
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "url",
                  "commit",
                  "version"
                ],
                "properties": {
                  "type": {
                    "const": "github-source"
                  },
                  "url": {
                    "$ref": "https://github.com/dataelement/awesome-dsh-workbench/schema/workbench.schema.json#/properties/url"
                  },
                  "commit": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "screenshots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "alt",
                "width",
                "height",
                "bytes",
                "sha256"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/[^/]+/.+"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2097152
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "probe": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "githubStars",
              "npmDownloads30d"
            ],
            "properties": {
              "githubStars": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "checkedAt",
                  "status"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "checkedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "status": {
                    "enum": [
                      "ok",
                      "stale",
                      "unavailable"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "enum": [
                            "ok",
                            "stale"
                          ]
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "value",
                        "checkedAt"
                      ],
                      "properties": {
                        "value": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "checkedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "value": {
                          "type": "null"
                        },
                        "checkedAt": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ]
              },
              "npmDownloads30d": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "checkedAt",
                  "status"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "checkedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "status": {
                    "enum": [
                      "ok",
                      "stale",
                      "unavailable",
                      "not_applicable"
                    ]
                  },
                  "start": {
                    "type": "string",
                    "format": "date"
                  },
                  "end": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "enum": [
                            "ok",
                            "stale"
                          ]
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "value",
                        "checkedAt",
                        "start",
                        "end"
                      ],
                      "properties": {
                        "value": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "checkedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "start": {
                          "type": "string",
                          "format": "date"
                        },
                        "end": {
                          "type": "string",
                          "format": "date"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "value": {
                          "type": "null"
                        },
                        "checkedAt": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ]
              },
              "githubReleaseDownloads": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "checkedAt",
                  "status"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "checkedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "status": {
                    "enum": [
                      "ok",
                      "stale",
                      "unavailable",
                      "not_applicable"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "enum": [
                            "ok",
                            "stale"
                          ]
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "value",
                        "checkedAt"
                      ],
                      "properties": {
                        "value": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "checkedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "value": {
                          "type": "null"
                        },
                        "checkedAt": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
